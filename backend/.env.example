SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# direct Postgres URL (Connect > Session pooler). Percent-encode @ # etc. in the password (@ = %40, # = %23)
SUPABASE_DB_URL=
# postgres (default, direct pooled connection, ~5x faster from India) | rest (Supabase REST API)
DB_ACCESS=postgres
OPENAI_API_KEY=

# memory (local, resets on restart) | supabase (persistent)
STATE_BACKEND=memory

# "Now" for the simulation. Default 2 Nov 2026 10:00 IST (the day the data is seeded for), running in real time.
# SIM_NOW=system uses the machine clock instead. SIM_FREEZE=true stops the clock (holds then never expire).
SIM_NOW=2026-11-02T10:00:00+05:30
SIM_FREEZE=false

# There is no scenario switch. What a booking does depends on the DAY you book (see docs/demo-days.md).

# ---- LangSmith tracing (optional; off unless LANGSMITH_TRACING=true AND a key is set) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=errand-agent
# EU accounts: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# only for organization-scoped keys
LANGSMITH_WORKSPACE_ID=
# false = send timings, tokens and tool names, but not prompt/reply text
LANGSMITH_SEND_PROMPTS=true

# ---- deployment (Vercel / serverless) ----
# Real instant (ISO) that counts as SIM_NOW. Without it every cold instance restarts the simulated clock.
# SIM_ANCHOR=2026-11-04T09:00:00+00:00
# Wrap the simulated clock back to SIM_NOW after this many hours: keeps "today" = Monday so the day-based demo flows hold.
# SIM_LOOP_HOURS=10
# Keep the pool small on serverless (many instances share one database); use the Supabase transaction pooler URL.
# DB_POOL_MIN=1
# DB_POOL_MAX=3
# Wait this long for the LangSmith trace to be sent before replying (serverless freezes right after the response).
# LANGSMITH_FLUSH_WAIT_S=2
# Required for POST /internal/tick (Vercel Cron sends it as a Bearer token). DEV_ENDPOINTS=true enables /dev/simulate/*.
# CRON_SECRET=
# DEV_ENDPOINTS=false
