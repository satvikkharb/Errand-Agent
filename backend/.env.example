SUPABASE_URL=https://chmnoexsebzhtknispib.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
OPENAI_API_KEY=

# memory (local, resets on restart) | supabase (persistent)
STATE_BACKEND=memory

# "Now" for the simulation. Default 2 Nov 2026 10:00 IST (the day the data is seeded for), running in real time.
# SIM_NOW=system uses the machine clock instead. SIM_FREEZE=true stops the clock (holds then never expire).
SIM_NOW=2026-11-02T10:00:00+05:30
SIM_FREEZE=false

# There is no scenario switch. What a booking does depends on the DAY you book (see docs/demo-days.md).
